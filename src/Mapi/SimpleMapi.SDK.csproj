<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net20;net40;netstandard2.0;net8.0-windows</TargetFrameworks>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
    <PackageId>Simple-MAPI.NET</PackageId>
    <Version>1.3.0</Version>
    <Authors>Peter van der Woude</Authors>
    <Product>Simple-Mapi.NET</Product>
    <Description>A .NET wrapper around Simple MAPI - a set of functions and related data structures to add messaging functionality to Windows-based apps</Description>
    <PackageReleaseNotes>fixes:
- Send no longer leaks unmanaged memory if the MAPI call throws
- more than 100 attachments now fails with MAPI_E_TOO_MANY_FILES instead of silently sending none
- falls back to ANSI and retries once if the mail client rejects the Unicode send
- SaveAttachm returns false when the named attachment is not in the message, instead of reporting success
- Error() covers codes 27 and 28, and can no longer index out of range
- Next() no longer throws when the client formats the date unexpectedly</PackageReleaseNotes>
    <Company />
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mapi, simple-mapi</PackageTags>
    <PackageProjectUrl>https://github.com/PandaWood/Simple-MAPI.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PandaWood/Simple-MAPI.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <AssemblyName>SimpleMapi.NET</AssemblyName>
    <RootNamespace>SimpleMapi</RootNamespace>
    <RunAnalyzersDuringBuild>False</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFrameworks)|$(Platform)'=='Debug|net20|AnyCPU'">
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
